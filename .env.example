# Run node scripts/setup-env.mjs to generate a private local .env.
POSTGRES_PASSWORD=generate-a-random-password
DATABASE_URL=postgres://aix:generate-a-random-password@localhost:55432/aix_workspace
REDIS_URL=redis://localhost:56379
BETTER_AUTH_SECRET=generate-32-random-bytes
BETTER_AUTH_URL=http://localhost:4173
# Exactly 32 bytes encoded as 64 hex characters; keep backed up with the database.
CREDENTIAL_ENCRYPTION_KEY=generate-64-hex-characters
UPLOAD_DIR=.data/uploads

# Organization model keys are entered in Settings. Composio is owned by AIX.
COMPOSIO_API_KEY=
# JSON map of toolkit slugs to the product auth config IDs. Server only.
COMPOSIO_AUTH_CONFIGS=
# Optional shared S3-compatible source storage (set on both web and worker).
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
